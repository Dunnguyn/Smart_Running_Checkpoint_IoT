' 7 Sequence GPS: auth, idempotency, two operating modes, commit and WS
@startuml
autonumber
participant "Wearable GPS and Steps" as W
participant "FastAPI GPS endpoint" as API
database "SQLite Database" as DB
participant "Geofence rules" as Geo
participant "WebSocket EventHub" as Hub
participant "Admin Web" as Web
W -> API : POST /api/v1/telemetry/gps
API -> API : authenticate source and API key
API -> DB : lookup idempotency_key
alt previously received sample
 DB --> API : saved GPS point
 alt same payload
  API --> W : 202 Accepted, duplicate=true
 else different payload with same key
  API --> W : 409 IDEMPOTENCY_CONFLICT
 end
else new sample
 API -> API : validate ACTIVE run, wearable, timestamp, steps, coordinates, speed
 alt invalid
  API --> W : 401 or 422; no telemetry saved
 else valid
  API -> DB : read prior GPS/geofence state
  API -> DB : save GPS point; update distance and steps
  alt GPS_ONLY
   API -> Geo : detect outside-to-inside checkpoint crossings
   Geo --> API : crossed checkpoints
   opt LAP checkpoint and minimum interval met
    API -> DB : create LapEvent; increment lap_count
    opt required lap count reached
     API -> DB : set COMPLETED, ended_at and duration_total_s
    end
   end
  else GPS_AND_ARDUINO
   API -> Geo : update geofence and create GPSPassage on entry
   Geo --> API : pending passage; no lap yet
  end
  API -> DB : COMMIT
  API -> Hub : publish runner.updated after commit
  opt crossing exists
   API -> Hub : publish checkpoint.passed after commit
  end
  opt run just completed
   API -> Hub : publish runner.completed after commit
  end
  Hub --> Web : race realtime events
  API --> W : 202 with lap_count and status
 end
end
@enduml

' 8 Sequence Arduino: pending event, durable worker match, Admin resolution
@startuml
autonumber
participant "HC-SR04" as Sensor
participant "Arduino UNO" as Arduino
participant "Laptop Gateway" as Gateway
participant "FastAPI Device Event API" as API
database "SQLite Database" as DB
participant "Background matching worker" as Worker
participant "WebSocket EventHub" as Hub
participant "Admin Web" as Web
Sensor -> Arduino : detect person passing
Arduino -> Gateway : event ID, device ID, timestamp
Gateway -> API : POST /api/v1/checkpoint-events
API -> API : authenticate gateway; require student_id=null; map device to checkpoint
alt GPS_ONLY
 API -> DB : save UNASSIGNED; no lap
 API -> DB : COMMIT
 API -> Hub : publish checkpoint.match.updated
 Hub --> Web : update event
 API --> Gateway : 202 UNASSIGNED
else event too old
 API -> DB : save UNASSIGNED / LATE_DEVICE_EVENT
 API -> DB : COMMIT
 API -> Hub : publish checkpoint.match.updated
 Hub --> Web : update event
 API --> Gateway : 202 UNASSIGNED
else GPS_AND_ARDUINO, event in age limit
 API -> DB : save PENDING_MATCH, deadline and version
 API -> DB : COMMIT
 API -> Hub : publish checkpoint.match.updated, PENDING_MATCH
 Hub --> Web : display pending event
 API --> Gateway : 202 event_id, PENDING_MATCH
 note over Worker, DB : Persisted pending rows are scanned after deadline and survive restart
 Worker -> DB : read due pending events
 Worker -> DB : find passages by race, checkpoint, configured time window
 alt none
  Worker -> DB : UNASSIGNED / NO_ELIGIBLE_PASSAGE
 else exactly one
  Worker -> DB : MATCHED; validate run, checkpoint and min lap interval
  opt eligible LAP checkpoint
   Worker -> DB : save LapEvent and increment lap_count
   opt total_laps reached
    Worker -> DB : set COMPLETED, ended_at and duration_total_s
   end
  end
 else multiple candidates or competing passage
  Worker -> DB : AMBIGUOUS; never guess runner
 end
 Worker -> DB : COMMIT matching result
 Worker -> Hub : publish checkpoint.match.updated after commit
 opt lap counted
  Worker -> Hub : publish runner.updated after commit
  opt run completed
   Worker -> Hub : publish runner.completed after commit
  end
 end
 Hub --> Web : update match and runner progress
 opt Admin later resolves AMBIGUOUS
  Web -> API : POST /checkpoint-events/{event_id}/resolve
  API -> DB : validate version, candidate and idempotency
  API -> DB : save confirm or dismiss plus audit
  API -> DB : COMMIT
  API -> Hub : publish result after commit
  Hub --> Web : update event
 end
end
@enduml

' 9 Swimlane: runner, Arduino, backend, Admin paths and outcomes
@startuml
|Runner wearable or Simulator|
start
:Send GPS and step snapshot;
|Backend FastAPI|
:Validate key and payload;
:Save GPS, steps and geofence state;
if (GPS crossing?) then (yes)
 if (Race mode?) then (GPS_ONLY)
  if (Checkpoint kind LAP?) then (yes)
   :Check min interval and record valid lap;
   if (Reached total_laps?) then (yes)
   :Freeze end time and duration, then mark COMPLETED;
   else (no)
    :Keep run ACTIVE;
   endif
  else (ordinary checkpoint)
   :Update location only;
  endif
 else (GPS_AND_ARDUINO)
  :Save GPS passage for matching, do not count lap yet;
 endif
else (no)
 :Update location only;
endif
:Commit and publish WebSocket;
|Arduino and Gateway|
:HC-SR04 detects passage;
:Gateway sends DeviceEvent with student_id=null;
|Backend FastAPI|
:Validate gateway and map device to checkpoint;
if (GPS_ONLY or event too old?) then (yes)
 :Persist UNASSIGNED, do not count lap;
 :Commit and publish event status;
else (GPS_AND_ARDUINO and in time)
 :Persist PENDING_MATCH and return 202;
 :Worker waits until deadline and searches eligible passages;
 if (Exactly one eligible candidate?) then (yes)
  if (Checkpoint LAP and interval valid?) then (yes)
   :Count lap and complete at required total;
  else (no)
   :Mark MATCHED without lap;
  endif
 else (none or multiple)
  if (No eligible candidate?) then (none)
   :Mark UNASSIGNED;
  else (multiple or competition)
   :Mark AMBIGUOUS, never guess;
   |Admin Web|
   :Confirm candidate or dismiss event;
   |Backend FastAPI|
   :Validate version/candidate and write audit;
  endif
 endif
 :Commit result before WebSocket;
endif
|Admin Web|
:Display dashboard, map, runners 01–05 and event status;
stop
@enduml

' 10 State Machine: run lifecycle
@startuml
[*] --> ACTIVE : valid run creation
ACTIVE --> ACTIVE : valid GPS/steps; target not reached
ACTIVE --> ACTIVE : ordinary checkpoint or lap rejected by minimum interval
ACTIVE --> COMPLETED : final valid lap reaches total_laps
ACTIVE --> COMPLETED : Admin calls finish-run
ACTIVE --> CANCELLED : Admin stops demo simulation
COMPLETED --> [*] : run finalized
CANCELLED --> [*] : run cancelled before completion
note right of ACTIVE
Only ACTIVE accepts telemetry.
GPS_ONLY counts from GPS geofence.
GPS_AND_ARDUINO counts after one Arduino event uniquely matches GPS passage.
end note
note right of COMPLETED
ended_at and duration_total_s are frozen.
Later telemetry is rejected because status is not ACTIVE.
end note
@enduml

