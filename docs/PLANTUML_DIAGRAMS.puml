' NEU Smart Running Backend UML — PlantUML source. Render each start/end block separately.
' BPMN is represented as swimlane activity diagrams (PlantUML has no separate BPMN grammar).

' 1 Use Case: actors and full function list
@startuml
left to right direction
actor "Quản trị viên" as A
actor "Thiết bị đeo hoặc Simulator" as W
actor "Arduino Gateway" as G
rectangle "NEU Smart Running Backend Web" {
 usecase "Tạo giải và checkpoint" as U1
 usecase "Xóa giải và dữ liệu thuộc giải" as U14
 usecase "Đăng ký sinh viên và wearable" as U2
 usecase "Khởi chạy mô phỏng 5 runner qua API" as U15
 usecase "Theo dõi hoặc dừng mô phỏng" as U16
 usecase "Theo dõi live và danh sách runner" as U3
 usecase "Xem lịch sử phiên chạy" as U4
 usecase "Cập nhật polyline tuyến và vị trí checkpoint" as U13
 usecase "Gửi GPS và tổng bước" as U5
 usecase "Xác định runner từ wearable ID" as U6
 usecase "Phát hiện vào vùng checkpoint bằng GPS" as U7
 usecase "Ghi lap hợp lệ" as U8
 usecase "Gửi sự kiện phát hiện người qua" as U9
 usecase "Chờ ghép GPS hoặc lưu UNASSIGNED ở GPS_ONLY" as U10
 usecase "Giữ AMBIGUOUS nếu có nhiều ứng viên" as U11
 usecase "Admin xác nhận hoặc loại sự kiện mơ hồ" as U12
}
A --> U1
A --> U14
A --> U2
A --> U15
A --> U16
A --> U3
A --> U4
A --> U13
W --> U5
U5 ..> U6 : <<include>>
U6 ..> U7 : <<include>>
U7 ..> U8 : <<include>>
G --> U9
U9 ..> U10 : <<include>>
U10 ..> U11 : <<extend>>
A --> U12
note bottom of G
Gateway reports passage only; it cannot identify a student.
end note
@enduml

' 2 Activity: GPS validation, duplicate protection, geofence and response
@startuml
start
:Receive GPS, total steps, wearable ID;
if (API key valid?) then (yes)
 :Continue;
 else (no)
 :Return 401 and allow retry without locking Admin;
 stop
endif
if (Run ACTIVE and wearable belongs to runner?) then (yes)
 :Continue;
else (no)
 :Return business validation error;
 stop
endif
if (Coordinates, timestamp, steps and speed valid?) then (yes)
 :Continue;
else (no)
 :Return 422;
 stop
endif
if (Idempotency key already received?) then (yes)
 :Do not apply data twice;
 stop
else (no)
 :Calculate distance and save GPS snapshot;
endif
if (Checkpoint crossing?) then (yes)
 if (Checkpoint kind LAP?) then (yes)
  if (Race mode?) then (GPS_ONLY)
   if (Minimum lap duration met?) then (yes)
    :Create LapEvent and increment lap_count;
    if (Required lap count reached?) then (yes)
     :Set COMPLETED, ended_at and duration_total_s;
    else (no)
     :Keep run ACTIVE;
    endif
   else (no)
    :Do not count lap;
   endif
  else (GPS_AND_ARDUINO)
   :Save GPS passage pending Arduino match, do not count lap yet;
  endif
 else (ordinary checkpoint)
  :Save checkpoint crossing without lap;
 endif
else (no)
 :Continue run without a checkpoint crossing;
endif
:Commit database transaction;
:Publish WebSocket only after commit;
:Return 202 Accepted;
stop
@enduml

' 3 BPMN AS-IS: runner, Arduino station, serial gateway, optional Sheets
@startuml
|Runner|
start
:Start;
repeat
:Pass START/FINISH station;
|Arduino UNO|
:HC-SR04 detects person;
if (ARMED and min lap interval met?) then (yes)
 :Increment lap and calculate distance;
 :Update LCD, LED and buzzer;
 :Send CSV through USB Serial;
 |Laptop Gateway|
 :Read Serial;
 if (Google Sheets enabled?) then (yes)
  :Optionally write Google Sheets;
 endif
 :Finish local session;
 stop
else (no)
 :Keep lap count unchanged;
 :Wait until runner leaves detection region;
 :Re-arm sensor;
endif
|Runner|
repeat while (Continue running?) is (yes)
:Finish local session;
|Laptop Gateway|
:Close local session and optional Google Sheets output;
stop
@enduml

' 4 BPMN TO-BE: web flow, route config, five runners, matching and completion
@startuml
|Admin Web|
start
:Call simulator API to create five runners and start all run clocks together;
:Create race, four checkpoints, students and wearable assignments;
:Update real map polyline and checkpoint positions before any run;
|Wearable or Simulator|
:Start run;
while (Run ACTIVE?) is (yes)
 :Send moving GPS and total steps continuously;
 |FastAPI Backend and SQLite|
 :Validate API key and payload;
 if (Valid?) then (yes)
  :Save GPS, steps, distance and geofence state;
  if (GPS crosses a checkpoint?) then (yes)
   if (Race mode?) then (GPS_ONLY)
    if (Checkpoint kind LAP?) then (yes)
     :Validate min lap interval, create lap and update run;
    else (ordinary checkpoint)
     :Save ordinary passage without counting lap;
    endif
   else (GPS_AND_ARDUINO)
    :Save GPS passage linked to wearable, do not count lap yet;
    |Arduino Gateway|
    :Send passage event with device ID and stable event ID, no student_id;
    |FastAPI Backend and SQLite|
    :Validate gateway, map device to checkpoint and save DeviceEvent;
    :Return 202 PENDING_MATCH and wait for configured match window/deadline;
    if (Exactly one eligible GPS candidate?) then (yes)
     :Mark MATCHED and validate run/checkpoint;
     if (LAP and minimum interval met?) then (yes)
      :Create LapEvent and increment lap_count;
     else (no)
      :Matched ordinary or invalid lap, do not count;
     endif
    else (none or multiple)
     if (No eligible GPS candidate?) then (none)
      :Mark UNASSIGNED / NO_ELIGIBLE_PASSAGE;
     else (multiple or passage competition)
      :Mark AMBIGUOUS and do not guess runner;
      |Admin Web|
      :Admin confirms candidate or dismisses event;
      |FastAPI Backend and SQLite|
      :Validate version, candidate and idempotency, then save audit;
      if (Confirmed LAP candidate?) then (yes)
       :Apply min interval and lap rules;
      else (dismiss or non-LAP)
       :Do not count lap;
      endif
     endif
    endif
   endif
  endif
   if (lap_count reached 4?) then (yes)
   :Freeze ended_at and duration_total_s, then set COMPLETED/DONE;
  endif
  :Commit, then publish WebSocket;
 else (no)
  :Return 401 or 422;
 endif
 |Admin Web|
 :Show dashboard, map, live status and runner results;
 |Wearable or Simulator|
endwhile (no)
:Run ends;
stop
@enduml

