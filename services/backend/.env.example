# Local/demo database. No SQL Server service is needed for this mode.
DATABASE_URL=sqlite:///./running_demo.db
# SQL Server option: create database iot_running, start SQL Server TCP/IP on port 1433,
# install Microsoft ODBC Driver 18, then set a real username/password:
# DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword@localhost:1433/iot_running?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
ADMIN_API_KEY=replace-with-a-long-admin-secret
SIMULATOR_API_KEY=replace-with-a-long-simulator-secret
WEARABLE_API_KEY=replace-with-a-long-wearable-secret
GATEWAY_API_KEY=replace-with-a-long-gateway-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MIN_LAP_INTERVAL_SECONDS=30
MAX_GPS_SPEED_MPS=12
MAX_SIMULATOR_SPEED_MPS=18
SIMULATOR_BASE_URL=http://127.0.0.1:8000
# Optional auto-connect: set COM3 and the server-side device/checkpoint IDs to enable.
# Keep ARDUINO_SERIAL_PORT blank when no kit is attached.
ARDUINO_SERIAL_PORT=
ARDUINO_SERIAL_BAUD=9600
ARDUINO_DEVICE_ID=
ARDUINO_CHECKPOINT_ID=
