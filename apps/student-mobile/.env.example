# Independent switches. Fake GPS is refused in API mode.
EXPO_PUBLIC_SERVICE_MODE=mock
EXPO_PUBLIC_GPS_MODE=demo
EXPO_PUBLIC_API_BASE_URL=
# Enable only for a rebuilt development/native client; requests permission at start.
EXPO_PUBLIC_BACKGROUND_GPS=false
# Restricted Android client Maps SDK key (package + signing certificate), never a server key.
ANDROID_MAPS_API_KEY=
