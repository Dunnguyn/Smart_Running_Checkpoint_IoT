{
  "name": "neu-run-student",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8083",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src App.tsx index.ts",
    "test": "vitest run",
    "build": "expo export --platform all",
    "test:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write App.tsx index.ts app.config.ts src tests scripts docs README.md *.json *.mjs *.mts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.30",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
